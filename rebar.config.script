%% Refuse an Erlang/OTP release reckon-db does not run on, before the build
%% reaches a dependency that would fail with a stack trace instead.
%%
%% Supported: OTP 28, the release CI builds and tests on and the only one
%% anything in this dependency set is built or tested on. The Khepri version
%% in the message is read from the pin in this file, so the message cannot go
%% on naming a version the build no longer uses. rebar3 evaluates this file
%% when reckon_db is fetched as a dependency too, so the message reaches the
%% application's build.
Release = list_to_integer(erlang:system_info(otp_release)),
Supported = 28,
Storage = case proplists:get_value(khepri, proplists:get_value(deps, CONFIG, [])) of
              undefined -> "khepri";
              KhepriVsn -> lists:flatten(["khepri ", KhepriVsn])
          end,
Unsupported = Release > Supported,
Unsupported andalso begin
    io:format(standard_error,
        "~nreckon_db supports Erlang/OTP ~b; this is OTP ~b.~n"
        "Its storage layer (~s) is only built and tested on OTP ~b.~n"
        "Build with OTP ~b (for example the erlang:~b image).~n"
        "See https://github.com/reckon-db-org/reckon-db#versions~n~n",
        [Supported, Release, Storage, Supported, Supported, Supported]),
    erlang:halt(1)
end,
CONFIG.
