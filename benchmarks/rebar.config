{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Local dev: override both deps via `_checkouts/` symlinks to the
%% sibling repos. This keeps the bench always aligned with the
%% current tree and avoids waiting on hex publication during the
%% early bench-driven iteration.
%%
%% Hex-published versions are declared below so the build still works
%% in CI / for contributors who don't have the sibling checkout.
{deps, [
    {reckon_db,            "~> 1.7"},
    {reckon_gater,         "~> 1.3"},
    {reckon_bench_harness, "~> 0.1"}
]}.

{profiles, [
    {bench, [
        {erl_opts, [debug_info]},
        {extra_src_dirs, ["slices"]},
        {src_dirs, ["slices"]}
    ]}
]}.

{shell, [
    {apps, [reckon_db, reckon_bench_harness]}
]}.

{dialyzer, [
    {warnings, [unknown, no_improper_lists]}
]}.
