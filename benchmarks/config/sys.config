%% Benchmark-local reckon_db configuration.
%%
%% Declares a single-node `bench_store' rooted at `./data/bench_store'.
%% Data is ephemeral per-run — scripts/wipe_data.sh clears it before
%% a fresh run. DO NOT point this at production data.
[
    {reckon_db, [
        {stores, [
            {bench_store, [
                {data_dir, "data/bench_store"},
                {mode, single}
            ]}
        ]}
    ]}
].
